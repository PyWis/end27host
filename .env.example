# --- Flask ---
SECRET_KEY=cambia-questa-chiave-lunga-e-casuale
# Percorso nascosto della pagina admin (non linkata da nessuna parte del sito)
ADMIN_PATH=/gestione-x7k2
# 1 se il sito è dietro un reverse proxy (nginx, caddy...): legge IP e https da X-Forwarded-*
TRUST_PROXY=0

# --- Superadmin iniziale (usato solo al primo avvio, poi va cambiato al primo accesso) ---
BASE_USER=endurance@2027.test
BASE_PASS=shalketon

# --- Sito / SEO ---
SITE_URL=http://localhost:5000
SITE_NAME=Endurance 2027
SITE_DESCRIPTION=Business, Marketing, Tecnologia e Formazione: prodotti e servizi Endurance 2027.

# --- Dati del venditore (footer, termini di vendita, privacy) ---
COMPANY_NAME=
COMPANY_VAT=
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PEC=

# --- Brevo (email: password admin, conferme ordine, link di pagamento) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Endurance 2027

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook: Stripe > Sviluppatori > Webhook > endpoint SITE_URL/stripe/webhook
# eventi: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 1 = campo «codice promozionale» nel checkout (i codici si creano su Stripe > Prodotti > Coupon)
STRIPE_PROMO_CODES=1
CURRENCY=eur

# --- Google Calendar: pagina di prenotazione call di vendita ---
# Google Calendar > Crea > Programma di appuntamenti > Condividi.
# Il link lungo (https://calendar.google.com/calendar/appointments/schedules/...) permette
# di mostrare il calendario dentro il sito; il link breve calendar.app.google apre Google.
GOOGLE_CALENDAR_BOOKING_URL=https://calendar.app.google/xxxxxxxx
# Opzionale: un link diverso per area (consulente dedicato); vuoto = usa quello sopra
GOOGLE_CALENDAR_BOOKING_URL_BUSINESS=
GOOGLE_CALENDAR_BOOKING_URL_MARKETING=
GOOGLE_CALENDAR_BOOKING_URL_TECNOLOGIA=
GOOGLE_CALENDAR_BOOKING_URL_FORMAZIONE=
# Giorni di validità predefiniti dei link di pagamento creati dopo la call
PAYLINK_DAYS=7

# --- Backup (flask --app run backup) ---
BACKUP_KEEP=14
